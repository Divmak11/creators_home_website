---
import Logo from './Logo.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={['header', compact && 'is-compact']} id="site-header">
	<div class="header-bar container">
		<a href="/" class="header-logo" aria-label="CreatorsHome — home">
			<Logo variant="light" />
		</a>
		<div class="header-actions">
			<nav class="header-nav" aria-label="Primary">
				<a href="/#work">Work</a>
				<a href="/#services">Services</a>
				<a href="/?role=creator#who" data-role="creator">Creators</a>
				<a href="/#faq">FAQ</a>
			</nav>
			<a href="/#contact" class="header-cta">Let's talk</a>
			<button type="button" class="header-menu-btn" id="menu-btn" aria-expanded="false" aria-controls="site-menu">
				<span class="menu-bars" aria-hidden="true">
					<span></span><span></span><span></span>
				</span>
				<span class="vh" id="menu-btn-label">Open menu</span>
			</button>
		</div>
	</div>
</header>

<div id="site-menu" class="site-menu" hidden>
	<div class="site-menu-inner container">
		<nav class="site-menu-nav" aria-label="Mobile">
			<a href="/#work" class="menu-pill" style="--r: -2deg">Work</a>
			<a href="/#services" class="menu-pill" style="--r: 2deg">Services</a>
			<a href="/?role=creator#who" data-role="creator" class="menu-pill" style="--r: -2deg">Creators</a>
			<a href="/#faq" class="menu-pill" style="--r: 2deg">FAQ</a>
			<a href="/#contact" class="menu-pill menu-pill--cta" style="--r: -2deg">Let's talk</a>
		</nav>
	</div>
</div>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: 64px;
		background: transparent;
		transition: translate .3s var(--e-smooth), background-color .3s var(--e-smooth), box-shadow .3s var(--e-smooth);
	}
	@media (min-width: 1200px) {
		.header {
			height: 80px;
		}
	}
	:global(html.js-motion) .header {
		animation: ch-drop .5s var(--e-smooth) both;
	}
	@keyframes ch-drop {
		from { translate: 0 -24px; opacity: 0; }
		to { translate: 0 0; opacity: 1; }
	}
	.header.is-compact {
		background: var(--c-ink);
		box-shadow: 0 6px 0 var(--c-ink-2);
	}
	.header.is-hidden {
		translate: 0 -100%;
	}
	.header-bar {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
	}
	.header-logo {
		text-decoration: none;
		display: flex;
		align-items: center;
	}
	@media (max-width: 767.98px) {
		.header-logo :global(svg) {
			width: 32px;
			height: 32px;
		}
	}
	.header-actions {
		display: flex;
		align-items: center;
		gap: 26px;
	}
	.header-nav {
		display: none;
	}
	@media (min-width: 1200px) {
		.header-nav {
			display: flex;
			align-items: center;
			gap: 26px;
		}
		.header-nav a {
			display: inline-flex;
			align-items: center;
			padding-block: 14px;
			text-decoration: none;
			color: var(--c-white);
			font-family: var(--f-body);
			font-weight: 700;
			font-size: 16px;
		}
	}
	@media (hover: hover) and (pointer: fine) {
		.header-nav a:hover {
			color: var(--c-hover-violet);
			text-decoration: underline;
		}
	}
	.header-cta {
		display: none;
		text-decoration: none;
		font-weight: 700;
		font-size: 16px;
		padding: 14px 24px;
		border-radius: var(--r-pill);
		background: var(--c-white);
		color: var(--c-ink);
		box-shadow: var(--sh-btn);
		transition: translate var(--t-s) var(--e-spring), box-shadow var(--t-s) var(--e-spring);
	}
	@media (min-width: 768px) {
		.header-cta {
			display: inline-block;
		}
	}
	.header-cta:active {
		translate: 0 0;
		box-shadow: 0 2px 0 var(--c-ink);
	}
	@media (hover: hover) and (pointer: fine) {
		.header-cta:hover {
			translate: 0 -3px;
			box-shadow: 0 9px 0 var(--c-ink);
		}
	}
	.header-menu-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: var(--r-pill);
	}
	@media (min-width: 1200px) {
		.header-menu-btn {
			display: none;
		}
	}
	.menu-bars {
		position: relative;
		width: 22px;
		height: 16px;
	}
	.menu-bars span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--c-white);
		transition: translate var(--t-s) var(--e-smooth), rotate var(--t-s) var(--e-smooth), opacity var(--t-s) var(--e-smooth);
	}
	.header.is-compact .menu-bars span {
		background: var(--c-white);
	}
	.menu-bars span:nth-child(1) { top: 0; }
	.menu-bars span:nth-child(2) { top: 7px; }
	.menu-bars span:nth-child(3) { top: 14px; }
	.header-menu-btn[aria-expanded='true'] .menu-bars span:nth-child(1) {
		translate: 0 7px;
		rotate: 45deg;
	}
	.header-menu-btn[aria-expanded='true'] .menu-bars span:nth-child(2) {
		opacity: 0;
	}
	.header-menu-btn[aria-expanded='true'] .menu-bars span:nth-child(3) {
		translate: 0 -7px;
		rotate: -45deg;
	}

	.site-menu {
		position: fixed;
		inset: 0;
		z-index: 60;
		background: var(--c-violet);
		overflow-y: auto;
	}
	.site-menu[hidden] {
		display: none;
	}
	.site-menu-inner {
		min-height: 100%;
		display: flex;
		align-items: center;
		padding-block: var(--s-26);
	}
	.site-menu-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--s-6);
	}
	.menu-pill {
		rotate: calc(var(--r, 0deg) * var(--tilt-k, 1));
		display: inline-block;
		text-decoration: none;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: 40px;
		background: var(--c-white);
		color: var(--c-ink);
		padding: var(--s-4) var(--s-8);
		border-radius: var(--r-pill);
	}
	.menu-pill--cta {
		background: var(--c-orange);
		color: var(--c-ink);
	}
	@media (max-width: 767.98px) {
		.menu-pill {
			font-size: 32px;
		}
	}
</style>

<script>
	const header = document.getElementById('site-header') as HTMLElement;
	const menuBtn = document.getElementById('menu-btn') as HTMLButtonElement;
	const menuBtnLabel = document.getElementById('menu-btn-label') as HTMLElement;
	const menu = document.getElementById('site-menu') as HTMLElement;

	let isOpen = false;
	let lastY = window.scrollY;
	let ticking = false;

	function onScroll() {
		const y = window.scrollY;
		header.classList.toggle('is-compact', y > 80);
		if (!isOpen && !header.contains(document.activeElement)) {
			if (y > lastY + 8) {
				header.classList.add('is-hidden');
				lastY = y;
			} else if (y < lastY - 8) {
				header.classList.remove('is-hidden');
				lastY = y;
			}
		}
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				requestAnimationFrame(() => {
					onScroll();
					ticking = false;
				});
				ticking = true;
			}
		},
		{ passive: true }
	);

	function getFocusable(): HTMLElement[] {
		return [menuBtn, ...Array.from(menu.querySelectorAll('a'))] as HTMLElement[];
	}

	function openMenu() {
		isOpen = true;
		menu.hidden = false;
		menuBtn.setAttribute('aria-expanded', 'true');
		menuBtnLabel.textContent = 'Close menu';
		document.documentElement.classList.add('menu-open');
		header.classList.remove('is-hidden');

		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const motionOn = document.documentElement.classList.contains('js-motion');
		const links = Array.from(menu.querySelectorAll('a')) as HTMLElement[];

		if (motionOn && !reduced && 'animate' in menu) {
			const rect = menuBtn.getBoundingClientRect();
			const cx = rect.left + rect.width / 2;
			const cy = rect.top + rect.height / 2;
			const maxR = Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy)) * 1.5;
			menu.animate(
				[
					{ clipPath: `circle(0px at ${cx}px ${cy}px)` },
					{ clipPath: `circle(${maxR}px at ${cx}px ${cy}px)` },
				],
				{ duration: 500, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' }
			);
			links.forEach((link, i) => {
				link.animate(
					[
						{ translate: '0 24px', opacity: 0 },
						{ translate: '0 0', opacity: 1 },
					],
					{ duration: 400, delay: i * 50, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'both' }
				);
			});
		}

		menuBtn.focus();
	}

	function closeMenu() {
		isOpen = false;
		menu.hidden = true;
		menuBtn.setAttribute('aria-expanded', 'false');
		menuBtnLabel.textContent = 'Open menu';
		document.documentElement.classList.remove('menu-open');
		menuBtn.focus();
	}

	menuBtn.addEventListener('click', () => {
		if (isOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	});

	menu.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => closeMenu());
	});

	document.addEventListener('keydown', (e) => {
		if (!isOpen) return;
		if (e.key === 'Escape') {
			closeMenu();
			return;
		}
		if (e.key === 'Tab') {
			const items = getFocusable();
			const first = items[0];
			const last = items[items.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}
	});
</script>
