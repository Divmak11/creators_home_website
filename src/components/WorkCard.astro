---
// One party-wall card (spec §4.4 card anatomy). Rendered inside `.wgrid`/the phone rail by
// Work.astro. The cell (`.wcell`) carries the tilt and the peek mini (so GSAP Flip on filter
// change moves the whole sticker); the card (`.wcard`) is the visible article.
import Icon from './Icon.astro';
import ArtPanel from './ArtPanel.astro';
import Slot from './Slot.astro';
import type { Campaign, Filter } from '../data/types.ts';
import { formatNum } from '../data/format.ts';

interface Props {
  campaign: Campaign;
}

const { campaign } = Astro.props;
const { cover, look, figure, badge, kicker, secondary, title, slug, platforms, filters, peek } = campaign;

const CATEGORY_PILL: Record<Filter, { bg: string; fg: string; border?: boolean }> = {
  film: { bg: 'var(--c-violet)', fg: 'var(--c-white)' },
  brands: { bg: 'var(--c-orange)', fg: 'var(--c-ink)' },
  celebs: { bg: 'var(--c-ink)', fg: 'var(--c-white)' },
  reddit: { bg: 'var(--c-white)', fg: 'var(--c-ink)', border: true },
};
const FILTER_LABEL: Record<Filter, string> = { film: 'Film & OTT', brands: 'Brands', celebs: 'Celebs', reddit: 'Reddit' };

const cap = (p: string) => p.charAt(0).toUpperCase() + p.slice(1);

const shc = look.bg === 'ink' ? 'var(--c-orange)' : 'var(--c-ink)';
const pillFilters = filters.slice(0, 2);
const peekItem = peek ? campaign.wall[0] : undefined;

const figureLabelPart = figure ? `${figure.num.display} ${figure.label}` : badge ? badge : '';
const cardAriaLabel = `${title} — ${figureLabelPart}`.trim();

const platformsLabel = `Platforms: ${platforms.map(cap).join(', ')}`;
---

<div class="wcell tilt" style={`--r: ${look.tilt}deg`} data-filters={filters.join(' ')}>
	{peekItem && (
		<div class="peek" aria-hidden="true">
			<Slot
				id={peekItem.slot}
				alt=""
				width={peekItem.width}
				height={peekItem.height}
				widths={[360]}
				class="peek-img"
				fill
			/>
		</div>
	)}

	<article class={`wcard bg-${look.bg}`} style={`--shc: ${shc};`}>
		<div class="panel" style={`view-transition-name: cover-${slug}; view-transition-class: cover;`}>
			{cover.kind === 'photo' ? (
				<Slot
					id={cover.slot}
					alt={cover.alt}
					width={cover.width}
					height={cover.height}
					widths={[400, 800]}
					sizes="(min-width: 1200px) 305px, (min-width: 768px) 45vw, 78vw"
					position={cover.position}
					class="cover-img"
					fill
				/>
			) : (
				<ArtPanel campaign={campaign} />
			)}

			<div class="pills" aria-hidden="true">
				{pillFilters.map((f) => (
					<span
						class="pill"
						style={`background: ${CATEGORY_PILL[f].bg}; color: ${CATEGORY_PILL[f].fg}; ${CATEGORY_PILL[f].border ? 'border: 2px solid var(--c-ink);' : ''}`}
					>
						{FILTER_LABEL[f]}
					</span>
				))}
			</div>

			{!peek && (
				<span class="sticker" aria-hidden="true">
					<Icon name={platforms[0]} size={18} />
				</span>
			)}
		</div>

		<h3 style={`view-transition-name: title-${slug};`}>
			<a href={`/work/${slug}/`} aria-label={cardAriaLabel} title={title}>{title}</a>
		</h3>

		<p class="kicker">{kicker}</p>

		{figure ? (
			<span class="cu-wrap" role="img" aria-label={`${figure.num.spoken} ${figure.label}`}>
				<span class="cu" data-to={figure.num.value} data-dec={figure.num.decimals} aria-hidden="true">
					{formatNum(figure.num.value, figure.num.decimals)}
				</span>
				<span class="sfx" aria-hidden="true">{figure.num.suffix}</span>
			</span>
		) : badge ? (
			<span class="badge tilt" style="--r: -3deg">{badge}</span>
		) : null}

		<p class="secondary">{secondary}</p>

		<div class="footer">
			<span class="platforms" role="img" aria-label={platformsLabel}>
				{platforms.map((p) => (
					<Icon name={p} size={16} />
				))}
			</span>
			<span class="open">Open the room <span class="arrow">→</span></span>
		</div>
	</article>
</div>

<style>
	.wcell {
		position: relative;
		transition: rotate var(--t-m) var(--e-spring), scale var(--t-m) var(--e-spring);
	}

	.peek {
		position: absolute;
		/* at rest the mini sits fully behind the card's top-right corner; hover lifts it ~45px above the edge */
		top: 8px;
		right: 40px;
		width: 96px;
		height: 128px;
		z-index: 0;
		border-radius: var(--r-field);
		border: 4px solid var(--c-ink);
		overflow: hidden;
		background: var(--c-white);
		translate: 30% 30%;
		rotate: 0deg;
		transition: translate .45s var(--e-spring), rotate .45s var(--e-spring);
	}
	.peek :global(.peek-img) {
		width: 100%;
		height: 100%;
	}

	.wcard {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		border-radius: var(--r-card-l);
		padding: var(--s-5);
		box-shadow: 0 var(--sh-y, 16px) 0 var(--shc);
		transition: box-shadow .2s var(--e-smooth);
	}
	.bg-orange {
		background: var(--c-orange);
		color: var(--c-ink);
	}
	.bg-white {
		background: var(--c-white);
		color: var(--c-ink);
	}
	.bg-ink {
		background: var(--c-ink);
		color: var(--c-white);
	}

	.panel {
		position: relative;
		border-radius: var(--r-panel);
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 2px solid var(--c-ink);
	}
	.panel :global(.cover-img) {
		width: 100%;
		height: 100%;
	}

	.pills {
		position: absolute;
		top: var(--s-3);
		left: var(--s-3);
		display: flex;
		gap: var(--s-2);
		flex-wrap: wrap;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		border-radius: var(--r-pill);
		padding: 4px var(--s-3);
		font-weight: 700;
		font-size: 12px;
	}

	.sticker {
		position: absolute;
		top: var(--s-3);
		right: var(--s-3);
		width: 36px;
		height: 36px;
		border-radius: var(--r-round);
		background: var(--c-white);
		color: var(--c-ink);
		display: flex;
		align-items: center;
		justify-content: center;
		scale: 0;
		transition: scale var(--t-m) var(--e-spring);
	}

	h3 {
		position: relative;
		margin: var(--s-4) 0 0;
		font-family: var(--f-display);
		font-weight: 700;
		font-size: var(--fs-h3);
	}
	h3 a {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-decoration: none;
	}
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.kicker {
		margin: var(--s-1) 0 0;
		font-family: var(--f-body);
		font-weight: 700;
		font-size: var(--fs-kicker);
		text-transform: uppercase;
		letter-spacing: 1.5px;
	}
	.bg-ink .kicker {
		color: var(--c-muted-ink);
	}
	.bg-orange .kicker,
	.bg-white .kicker {
		color: var(--c-muted-light);
	}

	.cu-wrap {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		white-space: nowrap;
		margin-top: var(--s-3);
		font-variant-numeric: tabular-nums;
	}
	.cu,
	.sfx {
		font-family: var(--f-display);
		font-weight: 800;
		font-size: var(--fs-card-figure);
		line-height: 1;
	}

	.badge {
		position: relative;
		display: inline-block;
		align-self: flex-start;
		margin-top: var(--s-3);
		background: var(--c-orange);
		color: var(--c-ink);
		border-radius: var(--r-pill);
		padding: var(--s-1) var(--s-4);
		font-family: var(--f-display);
		font-weight: 800;
		font-size: 22px;
	}

	.secondary {
		margin: var(--s-2) 0 0;
		font-weight: 500;
		font-size: 15px;
	}

	.footer {
		position: relative;
		margin-top: auto;
		padding-top: var(--s-4);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-3);
	}
	.platforms {
		display: flex;
		gap: var(--s-2);
	}
	.open {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-weight: 700;
		font-size: 14px;
		white-space: nowrap;
	}
	.arrow {
		display: inline-block;
		translate: 0 0;
		transition: translate .25s var(--e-smooth);
	}

	@media (min-width: 1200px) {
		.wcard {
			max-width: 330px;
		}
	}

	@media (max-width: 767.98px) {
		.wcard {
			padding: var(--s-4);
		}
		h3 {
			font-size: var(--fs-h3-phone);
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.wcell:hover,
		.wcell:focus-within {
			rotate: 0deg;
			scale: 1.03;
		}
		.wcell:hover .wcard,
		.wcell:focus-within .wcard {
			--sh-y: 22px;
		}
		.wcell:hover .peek,
		.wcell:focus-within .peek {
			translate: 0 -40%;
			rotate: 9deg;
		}
		.wcell:hover .sticker,
		.wcell:focus-within .sticker {
			scale: 1;
		}
		.wcell:hover .arrow,
		.wcell:focus-within .arrow {
			translate: 4px 0;
		}
	}

	.wcell:active {
		scale: .98;
	}
	.wcell:active .wcard {
		--sh-y: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		.peek {
			display: none;
		}
	}
	html[data-motion='paused'] .peek {
		display: none;
	}
</style>
