---
// Case-study hero (spec §3.2-2, §4.6 cover view-transition, BUILD.md §4 motion contract).
// Runs its entry on load (hero is always above the fold, no scroll trigger). Detects an
// incoming cross-document view transition via the `pagereveal` event (is:inline script,
// fires before module scripts) so the cover-pop tween only plays when there was no VT morph.
import Icon from '../Icon.astro';
import ArtPanel from '../ArtPanel.astro';
import Slot from '../Slot.astro';
import type { Campaign, Filter } from '../../data/types.ts';

interface Props {
  campaign: Campaign;
}

const { campaign } = Astro.props;
const { slug, title, kicker, filters, platforms, cover, figure, badge, dates, lead } = campaign;

const CATEGORY_PILL: Record<Filter, { bg: string; fg: string; border?: boolean }> = {
  film: { bg: 'var(--c-violet)', fg: 'var(--c-white)' },
  brands: { bg: 'var(--c-orange)', fg: 'var(--c-ink)' },
  celebs: { bg: 'var(--c-ink)', fg: 'var(--c-white)' },
  reddit: { bg: 'var(--c-white)', fg: 'var(--c-ink)', border: true },
};
const FILTER_LABEL: Record<Filter, string> = { film: 'Film & OTT', brands: 'Brands', celebs: 'Celebs', reddit: 'Reddit' };
const cap = (p: string) => p.charAt(0).toUpperCase() + p.slice(1);
---

<section class="case-hero" data-m="hero">
	<div class="deco tilt" aria-hidden="true" style="--r: -8deg">
		<Slot id="sticker:A-02" alt="" width={160} height={160} widths={[160, 320]} class="deco-img" />
	</div>

	<div class="container inner">
		<div class="copy">
			<nav aria-label="Breadcrumb">
				<ol>
					<li><a href="/#work">Work</a></li>
					<li aria-hidden="true" class="sep">›</li>
					<li><span aria-current="page">{title}</span></li>
				</ol>
			</nav>

			<div class="pills" aria-hidden="true">
				{filters.map((f) => (
					<span class="pill" style={`background: ${CATEGORY_PILL[f].bg}; color: ${CATEGORY_PILL[f].fg}; ${CATEGORY_PILL[f].border ? 'border: 2px solid var(--c-ink);' : ''}`}>
						{FILTER_LABEL[f]}
					</span>
				))}
				{platforms.map((p) => (
					<span class="chip">
						<Icon name={p} size={16} />
						{cap(p)}
					</span>
				))}
			</div>

			<h1>{title}</h1>
			<p class="kicker">{kicker}</p>
			{dates && <p class="dates"><time datetime={dates.iso}>{dates.label}</time></p>}
			<p class="lead">{lead}</p>
		</div>

		<div class="cover-col">
			<div class="cover-wrap tilt" style="--r: 2deg">
				<div class="cover-panel" style={`view-transition-name: cover-${slug}; view-transition-class: cover;`}>
					{cover.kind === 'photo' ? (
						<Slot
							id={cover.slot}
							alt={cover.alt}
							width={cover.width}
							height={cover.height}
							widths={[400, 800, 1200]}
							sizes="(min-width: 1200px) 40vw, (min-width: 768px) 70vw, 100vw"
							position={cover.position}
							loading="eager"
							class="cover-img"
						/>
					) : (
						<ArtPanel campaign={campaign} />
					)}
				</div>

				{figure ? (
					<div class="hero-sticker tilt bob loop" style="--r: 6deg">
						<span class="hs-figure">{figure.num.display}</span>
						<span class="hs-label">{figure.label}</span>
					</div>
				) : badge ? (
					<div class="hero-sticker badge tilt bob loop" style="--r: 6deg">{badge}</div>
				) : null}
			</div>
		</div>
	</div>
</section>

<script is:inline>
	window.__chArrivedByVT = false;
	addEventListener('pagereveal', (e) => {
		window.__chArrivedByVT = !!e.viewTransition;
	});
</script>

<script>
	import { gsap, motionOn, SplitText } from '../../scripts/motion/core';

	const hero = document.querySelector<HTMLElement>('.case-hero');

	if (hero) {
		if (motionOn()) {
			const h1 = hero.querySelector<HTMLElement>('h1');
			const lead = hero.querySelector<HTMLElement>('.lead');
			const cover = hero.querySelector<HTMLElement>('.cover-panel');

			if (h1) {
				const split = SplitText.create(h1, { type: 'words,lines', mask: 'lines', aria: 'auto' });
				gsap.fromTo(
					split.words,
					{ yPercent: 100 },
					{
						yPercent: 0,
						duration: 0.7,
						ease: 'ch-smooth',
						stagger: 0.05,
						onComplete: () => split.revert(),
					}
				);
			}

			if (lead) {
				gsap.fromTo(lead, { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, delay: 0.35, clearProps: 'transform,opacity' });
			}

			if (cover && !(window as unknown as { __chArrivedByVT?: boolean }).__chArrivedByVT) {
				gsap.fromTo(
					cover,
					{ scale: 0.6, rotation: -6, opacity: 0 },
					{ scale: 1, rotation: 0, opacity: 1, duration: 0.7, ease: 'ch-spring', delay: 0.2, clearProps: 'transform,opacity' }
				);
			}
		}
		hero.classList.add('is-in');
	}
</script>

<style>
	.case-hero {
		position: relative;
		background: var(--c-violet);
		color: var(--c-white);
		padding: var(--s-14) 0 var(--s-26);
		overflow: clip;
	}

	.deco {
		display: none;
	}

	.inner {
		display: grid;
		gap: var(--s-14);
		align-items: center;
	}

	nav ol {
		display: flex;
		align-items: center;
		gap: var(--s-2);
		font-size: var(--fs-small);
		font-weight: 700;
	}
	nav a {
		text-decoration: underline;
	}
	.sep {
		color: var(--c-hover-violet);
	}

	.pills {
		margin-top: var(--s-6);
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
	}
	.pill {
		display: inline-flex;
		align-items: center;
		border-radius: var(--r-pill);
		padding: 4px var(--s-3);
		font-weight: 700;
		font-size: 12px;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border-radius: var(--r-pill);
		padding: 4px var(--s-3);
		background: var(--c-white);
		color: var(--c-ink);
		font-weight: 700;
		font-size: 12px;
	}

	h1 {
		margin: var(--s-6) 0 0;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: clamp(40px, 5.4vw, 80px);
		line-height: 1.02;
		letter-spacing: -2px;
	}

	.kicker {
		margin: var(--s-4) 0 0;
		font-weight: 700;
		font-size: 15px;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--c-hover-violet);
	}

	.dates {
		margin: var(--s-2) 0 0;
		font-weight: 700;
		font-size: var(--fs-small);
	}

	.lead {
		margin: var(--s-6) 0 0;
		max-width: 560px;
		font-size: var(--fs-body-l);
	}

	.cover-col {
		display: flex;
		justify-content: center;
	}
	.cover-wrap {
		position: relative;
		width: 100%;
	}
	.cover-panel {
		border-radius: var(--r-card);
		box-shadow: var(--sh-hard);
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 2px solid var(--c-ink);
	}
	.cover-panel :global(.cover-img) {
		width: 100%;
		height: 100%;
	}

	.hero-sticker {
		position: absolute;
		top: -24px;
		right: -16px;
		background: var(--c-white);
		color: var(--c-ink);
		border-radius: var(--r-sticker);
		padding: var(--s-3) var(--s-5);
		text-align: center;
	}
	.hero-sticker.badge {
		background: var(--c-orange);
		font-family: var(--f-display);
		font-weight: 800;
		font-size: 20px;
		padding: var(--s-3) var(--s-6);
	}
	.hs-figure {
		display: block;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: 28px;
		line-height: 1;
	}
	.hs-label {
		display: block;
		margin-top: 4px;
		font-weight: 700;
		font-size: var(--fs-small);
	}

	@media (min-width: 1200px) {
		.inner {
			grid-template-columns: 7fr 5fr;
		}
	}

	@media (min-width: 768px) {
		.deco {
			display: block;
			position: absolute;
			/* bottom-right corner, under the cover: the left side holds breadcrumb and lead */
			bottom: var(--s-6);
			right: var(--s-8);
			width: 100px;
			z-index: 1;
		}
		.cover-wrap {
			max-width: 70%;
			margin-inline: auto;
		}
	}

	@media (min-width: 1200px) {
		.cover-wrap {
			max-width: 100%;
		}
	}

	@media (max-width: 767.98px) {
		.case-hero {
			padding: var(--s-10) 0 var(--s-14);
		}
		.inner {
			padding-inline: 16px;
		}
		.cover-wrap {
			--r: 3deg;
		}
	}

	/* Hidden-state contract (BUILD §4): written only under html.js-motion, matched to the
	   on-load `.is-in` swap in this component's module script. */
	:global(html.js-motion) .case-hero:not(.is-in) h1,
	:global(html.js-motion) .case-hero:not(.is-in) .lead,
	:global(html.js-motion) .case-hero:not(.is-in) .cover-panel {
		opacity: 0;
	}
</style>
