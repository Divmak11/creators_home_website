---
// Proof wall (case page, spec §4.5). Phone frames + taped prints, both open the shared
// Lightbox (mounted here, once). Hidden entirely when campaign.wall is empty (handled by the
// caller — [slug].astro only renders this when c.wall.length > 0).
import Slot from '../Slot.astro';
import Lightbox from '../Lightbox.astro';
import type { Campaign } from '../../data/types.ts';

interface Props {
  campaign: Campaign;
}

const { campaign } = Astro.props;
---

<section class="proof-wall">
	<div class="container">
		<h2>Proof on the wall</h2>

		<div class="wall-grid" data-m="tape">
			{campaign.wall.map((item, i) => {
				const mag = item.kind === 'print' ? 4 : 2;
				const tilt = i % 2 ? mag : -mag;
				return (
					<div class="wall-cell">
						<button type="button" class="wall-item tilt" style={`--r: ${tilt}deg`} data-index={i} data-caption={item.caption} aria-label={`Open: ${item.caption}`}>
							{item.kind === 'phone' ? (
								<span class="frame phone">
									<Slot
										id={item.slot}
										alt={item.alt}
										width={item.width}
										height={item.height}
										widths={[360, 720]}
										sizes="(min-width: 1200px) 22vw, (min-width: 768px) 40vw, 72vw"
										fit="cover"
										position="top"
										class="wall-img"
									/>
								</span>
							) : (
								<span class="frame print">
									<Slot
										id={item.slot}
										alt={item.alt}
										width={item.width}
										height={item.height}
										widths={[360, 720]}
										sizes="(min-width: 1200px) 22vw, (min-width: 768px) 40vw, 72vw"
										fit="cover"
										position="top"
										class="wall-img"
									/>
									<span class="tape" aria-hidden="true"></span>
								</span>
							)}
						</button>
						<p class="cap">{item.caption}</p>
					</div>
				);
			})}
		</div>

		<p class="wall-note">Screenshots of public posts from the campaign. Brand names and creatives belong to their owners.</p>
	</div>

	<Lightbox />
</section>

<script>
	import { gsap, onEnter } from '../../scripts/motion/core';

	const wall = document.querySelector<HTMLElement>('.proof-wall .wall-grid');
	const cells = wall ? Array.from(wall.querySelectorAll<HTMLElement>('.wall-item')) : [];

	if (wall && cells.length) {
		onEnter(wall, () => {
			cells.forEach((item, i) => {
				gsap.fromTo(
					item,
					{ y: -30, rotation: i % 2 ? 15 : -15, opacity: 0 },
					{
						y: 0,
						rotation: 0,
						opacity: 1,
						duration: 0.6,
						ease: 'back.out(1.6)',
						delay: i * 0.08,
						clearProps: 'transform,opacity',
						onComplete: () => {
							const tape = item.querySelector<HTMLElement>('.tape');
							if (tape) gsap.fromTo(tape, { scaleX: 0 }, { scaleX: 1, duration: 0.25, clearProps: 'transform' });
						},
					}
				);
			});
		});
	}
</script>

<style>
	.proof-wall {
		position: relative;
		background: var(--c-white);
		color: var(--c-ink);
		padding-block: var(--s-20);
	}

	h2 {
		margin: 0 0 var(--s-12);
		text-align: center;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: var(--fs-h2);
		letter-spacing: -1.5px;
	}

	.wall-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.wall-cell {
		display: flex;
		flex-direction: column;
	}

	.wall-item {
		display: block;
		width: 100%;
		border-radius: var(--r-img);
		transition: rotate var(--t-m) var(--e-spring), scale var(--t-m) var(--e-spring);
	}
	@media (hover: hover) and (pointer: fine) {
		.wall-item:hover {
			rotate: 0deg;
			scale: 1.03;
		}
	}

	.frame {
		display: block;
		position: relative;
	}
	.frame.phone {
		max-width: 240px;
		margin-inline: auto;
		border-radius: var(--r-card-l);
		border: 10px solid var(--c-ink);
		aspect-ratio: 9 / 19.5;
		overflow: hidden;
	}
	.frame.print {
		background: var(--c-white);
		border: 12px solid var(--c-white);
		box-shadow: var(--sh-hard);
		overflow: hidden;
	}
	.frame :global(.wall-img) {
		width: 100%;
		height: 100%;
	}

	.tape {
		position: absolute;
		top: -9px;
		left: 50%;
		translate: -50% 0;
		width: 64px;
		height: 18px;
		background: var(--c-orange);
		opacity: 0.7;
		clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 50%, 100% 100%, 6px 100%, 0 50%);
		transform-origin: center;
	}

	.cap {
		margin: var(--s-3) 0 0;
		font-size: var(--fs-small);
		font-weight: 700;
	}

	.wall-note {
		margin: var(--s-10) 0 0;
		text-align: center;
		font-size: var(--fs-small);
		color: var(--c-muted-light);
	}

	@media (min-width: 1200px) {
		.wall-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 28px;
		}
		.wall-cell:nth-child(4n+2) {
			margin-top: 40px;
		}
		.wall-cell:nth-child(4n+3) {
			margin-top: 12px;
		}
		.wall-cell:nth-child(4n+4) {
			margin-top: 52px;
		}
	}

	@media (max-width: 767.98px) {
		.proof-wall {
			padding-block: var(--s-14);
		}
		.wall-grid {
			display: flex;
			grid-template-columns: none;
			gap: 16px;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding-inline: 16px;
			margin-inline: calc(var(--s-4) * -1);
			scroll-padding-inline: 16px;
		}
		.wall-cell {
			flex: 0 0 72vw;
		}
	}

	/* Hidden-state contract (BUILD §4): written only under html.js-motion, matched to the
	   onEnter `data-m` + `.is-in` swap in scripts/motion/core.ts. */
	:global(html.js-motion) .wall-grid[data-m='tape']:not(.is-in) .wall-item {
		opacity: 0;
	}
</style>
