---
import { getSlot, type SlotId, type SlotSrc } from '../data/assets';

interface Props {
  id: SlotId;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fit?: 'cover' | 'contain';
  position?: string;
  fill?: boolean;
  priority?: boolean;
}

const {
  id,
  alt,
  width,
  height,
  widths,
  sizes,
  class: className,
  loading = 'lazy',
  fit = 'cover',
  position,
  fill = false,
  priority = false,
} = Astro.props;

const image = getSlot(id);

// `widths` filters the manifest's widths down to the requested subset (all if omitted). If the
// requested widths don't intersect what the manifest has for this slot, fall back to everything
// available rather than render an empty srcset.
function filterByWidths(list: SlotSrc[]): SlotSrc[] {
  if (!widths || widths.length === 0) return list;
  const matched = list.filter((f) => widths.includes(f.w));
  return matched.length ? matched : list;
}

const avifList = filterByWidths(image.avif);
const webpList = filterByWidths(image.webp);

function toSrcset(list: SlotSrc[]): string {
  return list.map((f) => `${f.src} ${f.w}w`).join(', ');
}

function closestTo800(list: SlotSrc[]): SlotSrc | undefined {
  if (!list.length) return undefined;
  return list.reduce((best, cur) => (Math.abs(cur.w - 800) < Math.abs(best.w - 800) ? cur : best));
}

const imgFile = closestTo800(webpList) ?? webpList[webpList.length - 1] ?? closestTo800(avifList) ?? avifList[avifList.length - 1];

const resolvedPosition = position ?? image.position ?? 'center';
const resolvedLoading = priority ? 'eager' : loading;
const fetchPriority = priority ? 'high' : 'low';

const pictureStyle = fill ? 'position: absolute; inset: 0;' : undefined;

const imgStyle = [
  'width: 100%',
  fill ? 'height: 100%' : 'height: auto',
  fill ? `object-fit: ${fit}` : null,
  `object-position: ${resolvedPosition}`,
  image.lqip ? `background-color: ${image.lqip}` : null,
]
  .filter(Boolean)
  .join('; ');
---

<picture class={className} style={pictureStyle}>
	{avifList.length > 0 && <source type="image/avif" srcset={toSrcset(avifList)} sizes={sizes} />}
	{webpList.length > 0 && <source type="image/webp" srcset={toSrcset(webpList)} sizes={sizes} />}
	<img
		src={imgFile?.src}
		width={width}
		height={height}
		alt={alt}
		loading={resolvedLoading}
		decoding="async"
		fetchpriority={fetchPriority}
		sizes={sizes}
		style={imgStyle}
	/>
</picture>
