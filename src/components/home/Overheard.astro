---
// Overheard at the party (home §3.1-12, spec §2.6; data quotes.ts). Hidden entirely while
// SHOW_OVERHEARD is false (BUILD.md §7 ruling — no client testimonials at launch; this section
// is built but not shown). ≥768: 3-column grid. <768: one-at-a-time snap rail with labelled
// prev/next buttons and dots (no autoplay). M-15 speech pop runs in the component <script>.
import { SHOW_OVERHEARD } from '../../config';
import QuoteCard from '../QuoteCard.astro';
import Slot from '../Slot.astro';
import { quotes } from '../../data/quotes';

const tilts = [-2, 2, -1];
---

{SHOW_OVERHEARD && (
	<section class="overheard" aria-labelledby="overheard-h">
		<div class="head">
			<div>
				<h2 id="overheard-h">Overheard at the party</h2>
				<p class="sub">Real comments on our campaign posts.</p>
			</div>
			<div class="sticker tilt" aria-hidden="true" style="--r: 8deg">
				<Slot id="sticker:A-03" alt="" width={160} height={160} widths={[160, 320]} />
			</div>
		</div>

		<div class="grid" data-m="speech">
			{quotes.map((q, i) => (
				<QuoteCard quote={q} tilt={tilts[i] ?? 0} colourIndex={(i % 3) as 0 | 1 | 2} />
			))}
		</div>

		<div class="rail-nav js-only">
			<button type="button" class="rail-btn prev" aria-label="Previous comment">‹</button>
			<div class="dots" role="group" aria-label="Comment">
				{quotes.map((_, i) => (
					<button
						type="button"
						class="dot"
						aria-label={`Comment ${i + 1} of ${quotes.length}`}
						aria-current={i === 0 ? 'true' : 'false'}
						data-index={i}
					/>
				))}
			</div>
			<button type="button" class="rail-btn next" aria-label="Next comment">›</button>
		</div>
	</section>
)}

<script>
	import { SHOW_OVERHEARD } from '../../config';
	import { gsap, onEnter, motionOn } from '../../scripts/motion/core';

	if (SHOW_OVERHEARD) {
		const section = document.querySelector<HTMLElement>('.overheard');
		const grid = section?.querySelector<HTMLElement>('.grid');
		const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.qcard')) : [];
		const prevBtn = section?.querySelector<HTMLButtonElement>('.rail-btn.prev');
		const nextBtn = section?.querySelector<HTMLButtonElement>('.rail-btn.next');
		const dots = section ? Array.from(section.querySelectorAll<HTMLButtonElement>('.dot')) : [];

		if (section && grid && cards.length) {
			// Rail nav (<768): dots track the intersecting card; prev/next scroll one card.
			if (dots.length) {
				function setActive(i: number): void {
					dots.forEach((d, idx) => d.setAttribute('aria-current', String(idx === i)));
				}

				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								const idx = cards.indexOf(entry.target as HTMLElement);
								if (idx !== -1) setActive(idx);
							}
						}
					},
					{ root: grid, threshold: 0.6 }
				);
				cards.forEach((c) => io.observe(c));

				function activeIndex(): number {
					const i = dots.findIndex((d) => d.getAttribute('aria-current') === 'true');
					return i === -1 ? 0 : i;
				}

				function goTo(i: number): void {
					const clamped = Math.max(0, Math.min(cards.length - 1, i));
					cards[clamped]?.scrollIntoView({ behavior: motionOn() ? 'smooth' : 'auto', inline: 'start', block: 'nearest' });
				}

				dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
				prevBtn?.addEventListener('click', () => goTo(activeIndex() - 1));
				nextBtn?.addEventListener('click', () => goTo(activeIndex() + 1));
			}

			// M-15 speech pop: alternating sides, tail pops right after landing, then words reveal.
			onEnter(grid, () => {
				const fromX = [-80, 80, -80];
				const fromRot = [8, -8, 8];
				cards.forEach((card, i) => {
					gsap.fromTo(
						card,
						{ x: fromX[i % fromX.length], rotation: fromRot[i % fromRot.length], opacity: 0 },
						{
							x: 0,
							rotation: 0,
							opacity: 1,
							duration: 0.7,
							ease: 'ch-spring',
							delay: i * 0.1,
							clearProps: 'transform,opacity',
							onComplete: () => {
								const tail = card.querySelector<HTMLElement>('[data-part="tail"]');
								const words = Array.from(card.querySelectorAll<HTMLElement>('.w'));
								if (tail) {
									gsap.fromTo(tail, { scale: 0 }, {
										scale: 1,
										duration: 0.3,
										ease: 'ch-spring',
										clearProps: 'transform',
										onComplete: () => {
											gsap.fromTo(words, { opacity: 0.2 }, { opacity: 1, duration: 0.2, stagger: 0.03, clearProps: 'opacity' });
										},
									});
								}
							},
						}
					);
				});
			});
		}
	}
</script>

<style>
	.overheard {
		max-width: 1320px;
		margin-inline: auto;
		padding: 0 32px var(--s-26);
	}

	.head {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: var(--s-6);
		text-align: center;
		margin-bottom: var(--s-12);
	}
	h2 {
		margin: 0;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: var(--fs-h2);
		letter-spacing: -1.5px;
	}
	.sub {
		margin: var(--s-2) 0 0;
		font-size: var(--fs-body-l);
	}
	.sticker {
		flex: none;
		width: 100px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(220px, 1fr));
		gap: var(--s-6);
	}

	.js-only {
		display: none;
	}
	:global(html.js) .js-only {
		display: flex;
	}

	.rail-nav {
		display: none;
	}

	@media (max-width: 767.98px) {
		.overheard {
			padding: 0 16px var(--s-14);
		}
		.head {
			text-align: left;
			justify-content: space-between;
		}
		.sticker {
			width: 72px;
		}

		.grid {
			grid-template-columns: none;
			display: flex;
			gap: 0;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-behavior: inherit;
		}
		.grid :global(.qcard) {
			flex: 0 0 100%;
			scroll-snap-align: start;
		}

		:global(html.js) .rail-nav {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--s-5);
			margin-top: var(--s-6);
		}
		.rail-btn {
			width: 44px;
			height: 44px;
			border-radius: var(--r-round);
			background: var(--c-ink);
			color: var(--c-white);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 22px;
		}
		.dots {
			display: flex;
			gap: var(--s-2);
		}
		.dot {
			width: 10px;
			height: 10px;
			border-radius: var(--r-round);
			background: var(--c-muted-ink);
		}
		.dot[aria-current='true'] {
			background: var(--c-orange);
		}
	}

	/* Hidden-state contract (BUILD §4): written only under html.js-motion, matched to the
	   onEnter `data-m` + `.is-in` swap in scripts/motion/core.ts. */
	:global(html.js-motion) .grid[data-m='speech']:not(.is-in) :global(.qcard) {
		opacity: 0;
	}
</style>
