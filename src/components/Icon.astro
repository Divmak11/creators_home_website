---
// Inline SVG icon set (BUILD.md component list). Two families:
// - Platform glyphs (instagram, facebook, x, reddit): simple filled single-colour shapes.
// - Art icons (trophy, reel, phone): 4px-stroke style matching the design's icon panels
//   (sources/designs/K_HomeParty_CreatorsHome.dc.html L128 trophy path, scaled up).
// Prop `label` present -> accessible glyph (role="img" + aria-label); absent -> aria-hidden.
interface Props {
  name: 'instagram' | 'facebook' | 'x' | 'reddit' | 'trophy' | 'reel' | 'phone';
  size: number;
  label?: string;
  class?: string;
  style?: string;
}

const { name, size, label, class: className, style } = Astro.props;

const STROKE_ICONS = new Set(['trophy', 'reel', 'phone']);
const isStroke = STROKE_ICONS.has(name);

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg
	class={className}
	style={style}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	fill={isStroke ? 'none' : 'currentColor'}
	stroke={isStroke ? 'currentColor' : undefined}
	stroke-width={isStroke ? 4 : undefined}
	stroke-linecap={isStroke ? 'round' : undefined}
	stroke-linejoin={isStroke ? 'round' : undefined}
	{...a11y}
>
	{name === 'instagram' && (
		<>
			<path
				fill-rule="evenodd"
				clip-rule="evenodd"
				d="M14 8h36a6 6 0 016 6v36a6 6 0 01-6 6H14a6 6 0 01-6-6V14a6 6 0 016-6zm18 14a10 10 0 100 20 10 10 0 000-20z"
			/>
			<circle cx="45" cy="19" r="3.5" />
		</>
	)}
	{name === 'facebook' && (
		<path d="M56 32a24 24 0 10-27.5 23.7V40.4h-6V32h6v-5.7c0-6 3.6-9.3 9-9.3 2.6 0 5.3.5 5.3.5v5.9h-3c-3 0-3.9 1.8-3.9 3.7V32h6.6l-1 8.4h-5.6v15.3A24 24 0 0056 32z" />
	)}
	{name === 'x' && (
		<path d="M14 10h8l10 13 10-13h8L36 29l16 25h-8L34 36 24 54h-8l16-25z" />
	)}
	{name === 'reddit' && (
		<>
			<path
				fill-rule="evenodd"
				clip-rule="evenodd"
				d="M32 54c12 0 20-7 20-16 0-3-1-5-3-7 1-1 2-3 2-5a6 6 0 00-10-4c-3-1-7-2-9-2s-6 1-9 2a6 6 0 00-10 4c0 2 1 4 2 5-2 2-3 4-3 7 0 9 8 16 20 16zm-8-18a4 4 0 118 0 4 4 0 01-8 0zm16 0a4 4 0 118 0 4 4 0 01-8 0z"
			/>
			<circle cx="32" cy="12" r="4" />
			<rect x="30" y="16" width="4" height="6" />
			<circle cx="18" cy="30" r="5" />
			<circle cx="46" cy="30" r="5" />
		</>
	)}
	{name === 'trophy' && (
		<path d="M24 10 H40 V18 A8 8 0 0 1 24 18 Z M24 12 H16 A6 6 0 0 0 24 22 M40 12 H48 A6 6 0 0 1 40 22 M32 26 V34 M26 34 H38" />
	)}
	{name === 'reel' && (
		<>
			<circle cx="32" cy="28" r="18" />
			<circle cx="32" cy="18" r="4" />
			<circle cx="42" cy="28" r="4" />
			<circle cx="32" cy="38" r="4" />
			<circle cx="22" cy="28" r="4" />
			<path d="M26 44 Q22 54 34 58" />
		</>
	)}
	{name === 'phone' && (
		<>
			<rect x="14" y="26" width="20" height="28" rx="4" transform="rotate(-12 24 40)" />
			<rect x="30" y="20" width="20" height="28" rx="4" transform="rotate(12 40 34)" />
		</>
	)}
</svg>
