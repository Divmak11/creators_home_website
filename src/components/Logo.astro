---
// A1's lockup (brand/logo.svg, brand/logo-ink.svg — hand-built SVG, viewBox 0 0 1153.58
// 176.73). `alt` defaults to the full wordmark; pass alt="" when the wrapping link already
// carries its own accessible name (e.g. an aria-label on the <a>).
interface Props {
  variant: 'light' | 'ink';
  size?: number;
  alt?: string;
}

const VIEWBOX_W = 1153.58;
const VIEWBOX_H = 176.73;

const { variant, size = 38, alt = 'CreatorsHome' } = Astro.props;
const src = variant === 'ink' ? '/brand/logo-ink.svg' : '/brand/logo.svg';
const width = Math.round((size * VIEWBOX_W) / VIEWBOX_H);
---

<img src={src} width={width} height={size} alt={alt} class="logo-img" />

<style>
	.logo-img {
		display: block;
		height: 38px;
		width: auto;
	}
	@media (max-width: 767.98px) {
		.logo-img {
			height: 32px;
		}
	}
</style>
