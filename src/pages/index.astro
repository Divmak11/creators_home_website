	canonicalPath="/"
>
	<Hero />
	<Ribbons />
	<Numbers />
	<Party />
	<Work />
	<Toggle />
	<Process />
	<Why />
	<Rooms />
	<Industries />
	<section id="faq" class="container stub"><h2>TODO faq</h2></section>
	<section id="contact" class="container stub"><h2>TODO contact</h2></section>
</Base>

<style>
	.stub {
		padding-block: var(--s-26);
	}
</style>
