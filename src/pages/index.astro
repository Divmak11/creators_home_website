---
import Base from '../layouts/Base.astro';
import { campaigns } from '../data/campaigns.ts';
import { faq } from '../data/faq.ts';
import { organization, website, itemList, faqPage } from '../lib/seo.ts';
import Hero from '../components/home/Hero.astro';
import Ribbons from '../components/home/Ribbons.astro';
import Numbers from '../components/home/Numbers.astro';
import Party from '../components/home/Party.astro';
import Work from '../components/home/Work.astro';
import Toggle from '../components/home/Toggle.astro';
import Process from '../components/home/Process.astro';
import Why from '../components/home/Why.astro';
import Rooms from '../components/home/Rooms.astro';
import Industries from '../components/home/Industries.astro';
import Overheard from '../components/home/Overheard.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';

const jsonLd = [organization(), website(), itemList(campaigns), faqPage(faq)].filter((d): d is object => d !== null);
---

<Base
	title="CreatorsHome · Influencer, Meme-Page & Reddit Marketing"
	description="CreatorsHome plans, seeds and tracks creator, meme-page and Reddit campaigns across Instagram, Facebook and X. 9M+ reach across our campaigns."
	canonicalPath="/"
	jsonLd={jsonLd}
>
	<Hero />
	<Ribbons />
	<Numbers />
	<Party />
	<Work />
	<Toggle />
	<Process />
	<Why />
	<Rooms />
	<Industries />
	<Overheard />
	<Faq />
	<Contact />
</Base>
