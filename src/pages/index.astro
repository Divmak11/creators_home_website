---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Ribbons from '../components/home/Ribbons.astro';
import Numbers from '../components/home/Numbers.astro';
import Party from '../components/home/Party.astro';
import Work from '../components/home/Work.astro';
import Toggle from '../components/home/Toggle.astro';
import Process from '../components/home/Process.astro';
import Why from '../components/home/Why.astro';
import Rooms from '../components/home/Rooms.astro';
